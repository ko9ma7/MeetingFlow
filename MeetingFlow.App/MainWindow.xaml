<Window x:Class="MeetingFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MeetingFlow.App.Models"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="MeetingFlow" Width="1280" Height="820" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#3157D5"/>
        <SolidColorBrush x:Key="Ink" Color="#172033"/>
        <SolidColorBrush x:Key="Muted" Color="#697386"/>
        <SolidColorBrush x:Key="Line" Color="#E2E6EE"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="Foreground" Value="#2949B3"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#BFC8DA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldComboBox" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
        <Style x:Key="PageTab" TargetType="TabItem">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="18,10"/>
        </Style>
        <Style x:Key="HeaderlessTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkflowStepButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <DataTemplate DataType="{x:Type models:MeetingRecord}">
            <Grid Margin="4,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding DisplayDate, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Text="{Binding MeetingType, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><Border Background="#EEF2FF" CornerRadius="12" Padding="9,4"><TextBlock Text="{Binding DurationText, Mode=OneWay}" Foreground="#3157D5" FontSize="11"/></Border><TextBlock Text="{Binding AiStatus, Mode=OneWay}" Foreground="#697386" FontSize="10" HorizontalAlignment="Right" Margin="0,4,2,0"/></StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Background="#182238">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="24,24,0,0">
                    <Border Width="38" Height="38" Background="#3157D5" CornerRadius="10"><TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Margin="12,-1,0,0"><TextBlock Text="MeetingFlow" Foreground="White" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="AI MEETING NOTES" Foreground="#8290AA" FontSize="9" FontWeight="SemiBold"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="WORKSPACE" Foreground="#71809C" FontSize="10" FontWeight="Bold" Margin="30,0,0,10"/>
                    <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Click="HomeNav_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="MicrophoneOutline" Width="30"/><TextBlock Text="새 회의"/></StackPanel></Button>
                    <Button x:Name="RecordsNav" Style="{StaticResource NavButton}" Click="RecordsNav_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="History" Width="30"/><TextBlock Text="회의 기록"/></StackPanel></Button>
                    <TextBlock Text="SYSTEM" Foreground="#71809C" FontSize="10" FontWeight="Bold" Margin="30,28,0,10"/>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CogOutline" Width="30"/><TextBlock Text="설정"/></StackPanel></Button>
                    <Button x:Name="AboutNav" Style="{StaticResource NavButton}" Click="AboutNav_Click"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="InformationOutline" Width="30"/><TextBlock Text="앱 정보"/></StackPanel></Button>
                </StackPanel>
                <Border Grid.Row="2" Margin="18" Padding="14" Background="#202C45" CornerRadius="9">
                    <StackPanel><TextBlock Text="로컬 STT / 선택적 AI" Foreground="#9BA8BE" FontSize="11"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Ellipse x:Name="ApiStatusDot" Width="8" Height="8" Fill="#35A46F" Margin="0,0,8,0"/><TextBlock x:Name="ApiStatusText" Text="엔진 확인 중" Foreground="White" FontSize="12"/></StackPanel></StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0"><TextBlock x:Name="PageTitle" Text="새 회의" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="UTF-8 · 로컬 우선 저장" Foreground="{StaticResource Muted}" FontSize="12"/><materialDesign:PackIcon Kind="LockOutline" Foreground="#35A46F" Margin="8,0,0,0"/></StackPanel></Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,20,28,12">
                <Grid x:Name="HomePage">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"><Border Width="28" Height="28" Background="#E8F7EF" CornerRadius="14"><TextBlock Text="1" Foreground="#25845A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,-1,0,0"><TextBlock Text="기록" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="실시간 로컬 저장" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></StackPanel>
                            <materialDesign:PackIcon Grid.Column="1" Kind="ChevronRight" Foreground="#AAB2C1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal"><Border Width="28" Height="28" Background="#EEF2FF" CornerRadius="14"><TextBlock Text="2" Foreground="#3157D5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,-1,0,0"><TextBlock Text="자동 전사" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="CPU 백그라운드 확정" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></StackPanel>
                            <materialDesign:PackIcon Grid.Column="3" Kind="ChevronRight" Foreground="#AAB2C1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal"><Border Width="28" Height="28" Background="#F5F6F8" CornerRadius="14"><TextBlock Text="3" Foreground="#697386" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,-1,0,0"><TextBlock Text="원문 검토" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="확인·수정·화자" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></StackPanel>
                            <materialDesign:PackIcon Grid.Column="5" Kind="ChevronRight" Foreground="#AAB2C1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal"><Border Width="28" Height="28" Background="#F5F6F8" CornerRadius="14"><TextBlock Text="4" Foreground="#697386" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="9,-1,0,0"><TextBlock Text="AI 보고서" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock Text="검토본으로 생성" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></StackPanel>
                        </Grid>
                    </Border>
                    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Style="{StaticResource HeaderlessTabControl}" SelectedIndex="0">
                        <TabItem Header="미팅 기록" Style="{StaticResource PageTab}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,14,8,8">
                                <StackPanel MaxWidth="1120">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.72*" MinWidth="360"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.28*"/></Grid.ColumnDefinitions>
                                        <materialDesign:Card Padding="22" UniformCornerRadius="12">
                                            <StackPanel>
                                                <TextBlock Text="현장 미팅 기록" FontWeight="SemiBold" FontSize="17" Foreground="{StaticResource Ink}"/>
                                                <TextBlock Text="시작하면 오디오와 실시간 전사가 즉시 로컬에 저장됩니다." Foreground="#25845A" FontSize="11" Margin="0,5,0,2" TextWrapping="Wrap"/>
                                                <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="제목" Style="{StaticResource SectionLabel}"/><TextBox x:Name="MeetingTitleBox" Style="{StaticResource FieldTextBox}" Text="새 기록"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="기록 상황" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="MeetingTypeBox" Style="{StaticResource FieldComboBox}" SelectedIndex="0" SelectionChanged="MeetingTypeBox_SelectionChanged"><ComboBoxItem Content="자동·일반 음성"/><ComboBoxItem Content="사내·업체 미팅"/><ComboBoxItem Content="드라마·영상·팟캐스트"/><ComboBoxItem Content="뉴스·시사·다큐"/><ComboBoxItem Content="설계·기술 검토"/><ComboBoxItem Content="인터뷰·면접"/><ComboBoxItem Content="고객·영업 상담"/><ComboBoxItem Content="강의·교육"/><ComboBoxItem Content="법률·규정"/></ComboBox></StackPanel>
                                                </Grid>
                                                <Grid Margin="0,2,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="전사 품질" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="HomeSttQualityBox" Style="{StaticResource FieldComboBox}" SelectionChanged="HomeSttQualityBox_SelectionChanged"/><TextBlock x:Name="HomeSttQualityHelp" Text="GPU 없이 CPU로 처리합니다." Foreground="#25845A" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="녹음 소스" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="AudioSourceBox" Style="{StaticResource FieldComboBox}" SelectedIndex="0" SelectionChanged="AudioSourceBox_SelectionChanged"><ComboBoxItem Content="마이크 입력" Tag="microphone"/><ComboBoxItem Content="시스템 소리 · 스피커 루프백" Tag="loopback"/></ComboBox><TextBlock x:Name="AudioSourceHelp" Text="마이크로 회의를 녹음합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="DeviceLabel" Text="PyAudio 입력 장치" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="DeviceBox" Style="{StaticResource FieldComboBox}"/>
                                            </StackPanel>
                                        </materialDesign:Card>
                                        <materialDesign:Card Grid.Column="2" Padding="22" UniformCornerRadius="12" Background="#F9FAFD" MinHeight="430">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal"><Ellipse x:Name="RecordingDot" Width="10" Height="10" Fill="#AAB2C1" Margin="0,2,9,0"/><TextBlock x:Name="RecordingStatus" Text="녹음 준비" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/></StackPanel>
                                                <StackPanel Grid.Row="1" Margin="0,10,0,10"><TextBlock x:Name="TimerText" Text="00:00:00" FontSize="34" FontWeight="Light" Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/><ProgressBar x:Name="LevelMeter" Height="6" Margin="22,10" Minimum="0" Maximum="1" Value="0"/><TextBlock x:Name="RecordingHint" Text="입력 장치를 선택하고 미팅 기록을 시작하세요" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                                                <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" MinHeight="220" Margin="0,0,0,12">
                                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="실시간 저장 전사 · 바로 수정 가능" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="LiveDraftStatusText" Text="로컬 자동 저장 대기" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="10"/></Grid><TextBlock Grid.Row="1" Text="4초 단위로 앞에서부터 표시됩니다. 잘못 인식된 문장을 클릭해 고치면 수정본도 자동 저장됩니다." Foreground="#25845A" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBox x:Name="LiveDraftBox" Grid.Row="2" Margin="0,8,0,0" Text="미팅 기록을 시작하면 첫 문장부터 순서대로 표시됩니다." TextChanged="LiveDraftBox_TextChanged" AcceptsReturn="True" SpellCheck.IsEnabled="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="White" Foreground="{StaticResource Ink}" FontSize="13"/></Grid>
                                                </Border>
                                                <StackPanel Grid.Row="3"><CheckBox x:Name="RecordingConsentBox" Content="참석자에게 녹음·전사 사실을 알렸습니다" HorizontalAlignment="Center" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="RecordButton" Style="{StaticResource PrimaryButton}" Click="RecordButton_Click" Content="미팅 기록 시작" MinWidth="148"/><Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Click="StopButton_Click" Content="종료하고 자동 확정" MinWidth="164" Margin="10,0,0,0" IsEnabled="False"/></StackPanel></StackPanel>
                                            </Grid>
                                        </materialDesign:Card>
                                    </Grid>
                                    <materialDesign:Card Margin="0,18,0,0" Padding="16" UniformCornerRadius="12">
                                        <Expander Header="선택 설정 · AI 보고서, 화자 구분, 보고서 범위" IsExpanded="False">
                                        <StackPanel Margin="0,12,0,0">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="보고서 유형 · 12종" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/><ComboBox x:Name="HomeReportTemplateBox" Style="{StaticResource FieldComboBox}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="정리 수준" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/><ComboBox x:Name="HomeAiModeBox" Style="{StaticResource FieldComboBox}" SelectedIndex="2"><ComboBoxItem Content="사용 안 함" Tag="사용 안 함"/><ComboBoxItem Content="간단" Tag="간단 정리"/><ComboBoxItem Content="표준" Tag="표준 회의록"/><ComboBoxItem Content="상세" Tag="상세 회의록"/></ComboBox></StackPanel></Grid>
                                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="화자 구분" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/><ComboBox x:Name="HomeSpeakerModeBox" Style="{StaticResource FieldComboBox}" SelectedIndex="0"><ComboBoxItem Content="사용 안 함 · 가장 빠름" Tag="off"/><ComboBoxItem Content="자동 감지 · 최대 인원 사용" Tag="auto"/><ComboBoxItem Content="화자 수 고정" Tag="fixed"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="예상·최대 화자 수 (1~12)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/><TextBox x:Name="HomeSpeakerCountBox" Style="{StaticResource FieldTextBox}" Text="2"/></StackPanel></Grid>
                                            <TextBlock Text="화자 구분을 켜면 pyannote가 실제 음성 구간을 분석해 화자 A·B·C로 표시합니다. 사용할 수 없을 때 임의 라벨을 만들지 않습니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                            <Border Background="#F8FAFC" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0"><StackPanel><Grid><TextBlock Text="AI 보고서 적용 구간" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/><TextBlock x:Name="MediaDurationText" Text="오디오를 녹음하거나 가져오면 전체 길이가 표시됩니다" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11"/></Grid><TextBlock Text="STT는 전체 음성을 처리하며, 아래 범위는 검토 완료 후 Gemini 보고서에 전달할 구간입니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="시작" VerticalAlignment="Center"/><Slider x:Name="HomeRangeStartSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="0" IsEnabled="False" ValueChanged="HomeRangeSlider_ValueChanged"/><TextBox x:Name="HomeRangeStartBox" Grid.Column="2" Text="00:00:00" Margin="12,0,0,0" Padding="8" LostFocus="HomeRangeTimeBox_LostFocus" IsEnabled="False"/></Grid><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="종료" VerticalAlignment="Center"/><Slider x:Name="HomeRangeEndSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" IsEnabled="False" ValueChanged="HomeRangeSlider_ValueChanged"/><TextBox x:Name="HomeRangeEndBox" Grid.Column="2" Text="00:00:00" Margin="12,0,0,0" Padding="8" LostFocus="HomeRangeTimeBox_LostFocus" IsEnabled="False"/></Grid></StackPanel></Border>
                                        </StackPanel>
                                        </Expander>
                                    </materialDesign:Card>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,8"><Button x:Name="TranscribeButton" Style="{StaticResource PrimaryButton}" Click="TranscribeButton_Click" Content="가져온 오디오 전사 시작" IsEnabled="False" Visibility="Collapsed"/><Button x:Name="ImportButton" Style="{StaticResource SecondaryButton}" Click="ImportButton_Click" Content="오디오 파일 가져오기" Margin="10,0,0,0"/><Button Style="{StaticResource SecondaryButton}" Click="DemoButton_Click" Content="화면 체험" Margin="10,0,0,0"/><Button Style="{StaticResource SecondaryButton}" Click="NewMeetingButton_Click" Content="새 미팅 준비" Margin="10,0,0,0"/></StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="검토 · AI 보고서" Style="{StaticResource PageTab}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border x:Name="ProgressBanner" Background="#EEF2FF" BorderBrush="#CAD5FF" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><materialDesign:PackIcon Kind="Sync" Foreground="#3157D5" Width="20" Height="20"/><StackPanel Grid.Column="1" Margin="10,0"><TextBlock x:Name="ProgressText" Text="처리 중입니다" Foreground="#2949B3"/><ProgressBar x:Name="ProcessingProgressBar" Height="4" Margin="0,7,0,0" Minimum="0" Maximum="1" Value="0"/></StackPanel><Button x:Name="CancelProcessingButton" Grid.Column="2" Content="작업 취소" Click="CancelProcessingButton_Click" Padding="12,5"/></Grid>
                                </Border>
                                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                    <Grid><TextBlock Text="확정 전사를 먼저 검토한 뒤 필요한 경우에만 Gemini 보고서를 만드세요." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource WorkflowStepButton}" Content="원문 검토 보기" Click="ShowTranscriptReview_Click"/><Button Style="{StaticResource WorkflowStepButton}" Content="이중 전사 비교" Click="ShowSttComparison_Click" Margin="8,0,0,0"/><Button Style="{StaticResource WorkflowStepButton}" Content="AI 보고서 보기" Click="ShowAiReport_Click" Margin="8,0,0,0"/></StackPanel></Grid>
                                </Border>
                                <materialDesign:Card Grid.Row="2" Padding="0" UniformCornerRadius="12">
