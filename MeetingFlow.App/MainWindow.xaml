                                <TextBlock Text="기본 정리 수준" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="AiModeBox" Style="{StaticResource FieldComboBox}"><ComboBoxItem Content="사용 안 함 · 로컬 원문만" Tag="사용 안 함"/><ComboBoxItem Content="간단 정리" Tag="간단 정리"/><ComboBoxItem Content="표준 회의록" Tag="표준 회의록"/><ComboBoxItem Content="상세 회의록" Tag="상세 회의록"/></ComboBox>
                                <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="기본 시작 위치(분)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/><TextBox x:Name="AiRangeStartBox" Style="{StaticResource FieldTextBox}" Text="0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="기본 종료 위치(분, 0=끝)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/><TextBox x:Name="AiRangeEndBox" Style="{StaticResource FieldTextBox}" Text="0"/></StackPanel></Grid>
                                <TextBlock Text="응답 창의성" Style="{StaticResource SectionLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><Slider x:Name="TemperatureSlider" Minimum="0" Maximum="1" TickFrequency="0.1" Value="0.2"/><TextBlock x:Name="TemperatureValue" Grid.Column="1" Text="0.2" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                <CheckBox x:Name="RequireReviewBox" Content="전사 원문을 검토·저장한 후에만 AI 보고서 생성 · 권장" IsChecked="True" Margin="0,14,0,0"/>
                                <CheckBox x:Name="AutoSummaryBox" Content="고급: 검토 단계를 생략하고 자동 AI 실행" IsChecked="False" Margin="0,9,0,0"/>
                                <TextBlock Text="사용자 지침" Style="{StaticResource SectionLabel}"/><TextBox x:Name="PromptBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="0,16,0,0" Padding="22" UniformCornerRadius="12"><StackPanel><TextBlock Text="기능 노출·자동화" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="ShowTimelineEditorBox" Content="새 회의에서 AI 적용 시간축 표시" Margin="0,14,0,0"/><CheckBox x:Name="AutoSelectGeminiModelBox" Content="연결 진단에서 사용 가능한 모델 목록 확인" Margin="0,10,0,0"/><CheckBox x:Name="AutoRetryPendingAiBox" Content="연결 테스트 성공 시 AI 대기 기록 자동 재처리" Margin="0,10,0,0"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="AI 연결 확인 제한시간" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><TextBox x:Name="GeminiTimeoutBox" Grid.Column="1" Style="{StaticResource FieldTextBox}" Text="20" ToolTip="5~60초"/></Grid></StackPanel></materialDesign:Card><StackPanel Orientation="Horizontal" Margin="0,16,0,8"><Button Style="{StaticResource PrimaryButton}" Content="설정 저장" Click="SaveSettingsButton_Click"/><Button Style="{StaticResource SecondaryButton}" Content="선택 AI 연결 진단" Click="TestConnectionButton_Click" Margin="10,0,0,0"/><Button Style="{StaticResource SecondaryButton}" Content="AI 대기 작업 다시 처리" Click="RetryPendingAiButton_Click" Margin="10,0,0,0"/><TextBlock x:Name="SettingsMessage" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="380"/></StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="AboutPage" Visibility="Collapsed"><materialDesign:Card Width="660" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="42" UniformCornerRadius="16"><StackPanel HorizontalAlignment="Center"><Border Width="70" Height="70" Background="#3157D5" CornerRadius="18"><TextBlock Text="M" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="MeetingFlow" FontSize="28" FontWeight="SemiBold" Margin="0,18,0,0"/><TextBlock x:Name="VersionText" Text="버전 1.6.0" Foreground="{StaticResource Muted}" Margin="0,5,0,20"/><TextBlock Text="실시간 초안 · 검토 우선 전사 · 선택형 화자 분리 · 12종 Gemini 보고서" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}"/><TextBlock Text="오디오와 변경되지 않는 STT 원본은 로컬에 보존됩니다. 사용자가 검토를 완료하기 전에는 Gemini에 전사 내용을 보내지 않습니다." TextWrapping="Wrap" TextAlignment="Center" Foreground="#7C5B16" Background="#FFF8E6" Padding="14" Margin="0,22,0,0"/></StackPanel></materialDesign:Card></Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="28,0"><TextBlock x:Name="FooterStatus" Text="준비됨" Foreground="#8790A2" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="MeetingFlow · UTF-8 · 로컬 우선 저장" Foreground="#A0A7B4" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
        </Grid>
    </Grid>
</Window>
